# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Security
API_KEY=your-secret-key
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/bank-statement-dev
MONGODB_URI=mongodb://localhost:27017/bank-statement-dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://localhost:6380

# Perplexity API Configuration
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions

# Vera AI — Gemini briefing
USE_MOCK_SERVICES=false
USE_VERA_BRIEFING_V2=true
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Zoho CRM Configuration
ZOHO_CRM_URL=https://www.zohoapis.com/crm/v2
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:3000/auth/zoho/callback
ZOHO_JS_DOMAIN=http://localhost:3000
ZOHO_SCOPE=ZohoCRM.modules.ALL,ZohoCRM.files.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ,crm.attach.READ,workdrive.files.READ

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
