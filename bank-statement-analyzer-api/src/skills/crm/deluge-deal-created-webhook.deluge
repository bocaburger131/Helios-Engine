// Zoho Deluge — Deal Created → Helios webhook
// Workflow: Deals module, trigger On Create
// Replace HELIOS_WEBHOOK_URL and HELIOS_WEBHOOK_SECRET before deploy.

dealId = input.dealId;
if(dealId == null)
{
	dealId = zoho.crm.getRecordById("Deals", input.Deal_Id);
}

payload = Map();
payload.put("event", "deal.created");
payload.put("dealId", dealId.toString());
payload.put("correlationId", dealId.toString());
payload.put("module", "Deals");
payload.put("dealName", ifnull(input.Deal_Name, ""));
payload.put("stage", ifnull(input.Stage, ""));

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-Helios-Webhook-Secret", "HELIOS_WEBHOOK_SECRET");

response = invokeurl
[
	url :"HELIOS_WEBHOOK_URL/api/crm/webhooks/zoho/deal-created"
	type :POST
	parameters:payload.toString()
	headers:headers
];

info "Helios deal-created webhook response: " + response;
