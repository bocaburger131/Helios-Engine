# Copy to .env and fill in values (never commit .env)

# Auth — JWT signing (required for POST /api/auth/login)
JWT_SECRET=change-me-in-local-dev

# Optional demo / public upload (not used for login; seed user via npm run seed:admin)
DEMO_MODE=true
ENABLE_PUBLIC_UPLOAD=true
# PUBLIC_UPLOAD_MAX_PER_HOUR=10
# DISABLE_AUTH=true
# APP_MODE=demo

# Vera envelope — use contract mocks until live engines are validated end-to-end
USE_MOCK_SERVICES=false

# Vera AI briefing — Gemini structured output (falls back to Perplexity on failure)
USE_VERA_BRIEFING_V2=true
# VERA_BRIEFING_MODEL=gemini-flash-latest
# VERA_BRIEFING_TEMPERATURE=0.25

# Redis — streams (XADD/XGROUP) require Redis 5.0+ for background job worker
# REDIS_HOST=localhost
# REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380

# Upload Hub demo (optional)
# DISABLE_AUTH=true
# APP_MODE=demo

# Helios layout learning (Gemini vision) — required for Wells Fargo batch rescue; set at least one key
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_VISION_MODEL=gemini-flash-latest
# GEMINI_VISION_MIN_INTERVAL_MS=600
# Direct row extraction for non-batch single-statement flows (optional)
GEMINI_VISION_ROW_FALLBACK=true
# GEMINI_VISION_ROW_MODEL=gemini-flash-latest
# Wells: one Gemini row call before legacy bleed when text pipeline fails (default on)
# WELLS_INITIATE_FAST_GEMINI=true
# Batch macro: per-file vision row loops (default off — one layout teach per RTN + local re-parse)
# Plan C: per-file Gemini row rescue after layout re-parse (default on; set false to opt out)
BATCH_USE_VISION_ROW_FALLBACK=true
# Min rows from column-mapped layout before falling back to Wells grid parser
# LAYOUT_COLUMN_MIN_ROWS=10
# Revalidate Mongo LEARNING templates against digital pdf-parse text before apply (default on)
# BATCH_FORCE_TEMPLATE_REVALIDATE=true
# PDF chars/page below this → scan mode routing (Phase 3 OCR)
# PDF_LOW_TEXT_CHARS_PER_PAGE=120
# GEMINI_VISION_LAYOUT_MAX_PAGES=8
# Macro batch integrity gate is fixed at 0.8 (80% of statements must reconcile); not lowered for demos
# MACRO_CHECKSUM_MIN_OK_RATIO=0.8

# Spatial pdfplumber rescue (production: Python 3 + pip install -r scripts/requirements.txt)
PDFPLUMBER_ENABLED=true
# Run pdfplumber in parallel with pdf-parse on every digital PDF; cross-reference before batch rescue
PDFPLUMBER_DUAL_PARSE=true
PYTHON_PATH=python
PDFPLUMBER_TIMEOUT_MS=120000
# PDFPLUMBER_SCRIPT=scripts/extract_tables.py

# Perplexity (application PDF text + transaction categories)
# PERPLEXITY_API_KEY=
# PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions

# ── Modular AI providers (aiOrchestratorService) ──
# Swap which LLM answers each job without touching callers.
VISION_PROVIDER=gemini             # gemini | claude  -> layout teach
CATEGORIZATION_PROVIDER=perplexity # perplexity | claude -> transaction categorization
DIAGNOSTIC_PROVIDER=gemini         # gemini | claude  -> checksum mismatch diagnosis (text-only)
# ANTHROPIC_API_KEY=               # required when any provider above is "claude"
# CLAUDE_VISION_MODEL=claude-sonnet-4-20250514
# CLAUDE_DIAGNOSTIC_MODEL=claude-sonnet-4-20250514
# GEMINI_DIAGNOSTIC_MODEL=gemini-2.0-flash

# ── Diagnostic AI Rescue (replaces brute-force vision row extraction) ──
# Master switch: diagnose anomalies + programmatic auto-correct instead of re-extracting rows.
AI_DIAGNOSTIC_RESCUE_ENABLED=true
# Min confidence for an automatic COLUMN_FLIP credit/debit correction.
AI_DIAGNOSTIC_AUTO_CORRECT_MIN_CONFIDENCE=0.8
# Dev fast path: skip diagnostic AI too and save parser output as-is with warnings.
# THIN_PARSER_MODE=false
