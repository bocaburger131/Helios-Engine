NODE_ENV=test
PORT=5001
MONGODB_URI=mongodb://localhost:27017/bank-analyzer-test
JWT_SECRET=test-secret-key
JWT_EXPIRE=7d
JWT_EXPIRES_IN=7d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_MOCK=true
USE_REDIS=false
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
LOG_LEVEL=error

# Gemini (mocked in unit tests; set for integration runs that hit live APIs)
GEMINI_API_KEY=
GOOGLE_API_KEY=
USE_VERA_BRIEFING_V2=false
